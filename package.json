{
  "name": "sankhuu",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @sankhuu/db generate",
    "db:migrate": "pnpm --filter @sankhuu/db migrate",
    "db:studio": "pnpm --filter @sankhuu/db studio",
    "db:deploy": "pnpm --filter @sankhuu/db migrate:deploy"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "typescript": "^5.9.0"
  }
}
