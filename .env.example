# ── Мэдээллийн сан ──
# Локал хөгжүүлэлт (docker compose up -d) бол хоёуланд нь адилхан утга өгнө:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sankhuu"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sankhuu"

# Supabase бол (Project → Connect → ORMs / Connection string):
# Апп ажиллах үед: Transaction pooler (порт 6543)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Migration хийхэд: Session pooler (порт 5432)
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Supabase Auth (Project Settings → API Keys) ──
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# Publishable key (sb_publishable_...). Оронд нь NEXT_PUBLIC_SUPABASE_ANON_KEY-г ашиглаж болно
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Зураг хадгалах (Supabase Storage, зөвхөн серверт) ──
# Project Settings → API Keys → Secret key (sb_secret_...) эсвэл хуучин service_role key.
# Байхгүй бол локал хөгжүүлэлтэд зургууд apps/web/.uploads/ хавтсанд хадгалагдана.
SUPABASE_SECRET_KEY=""

# ── Сайтын үндсэн хаяг (заавал биш; хуваалцах зураг, холбоосыг бүтэн болгоход) ──
# Өгөөгүй бол Vercel-ийн production домэйн, эс бөгөөс https://erp.flexlink.mn
NEXT_PUBLIC_SITE_URL=""

# ── SMS мэдэгдэл ──
# log (анхдагч): жинхэнэ SMS явахгүй, мессеж бүр DB-д бүртгэгдэж /admin/sms дээр харагдана (туршилт).
# http: SMS_HTTP_URL руу POST JSON {to, text, from} (Authorization: Bearer SMS_HTTP_TOKEN); 2xx = илгээгдсэн.
SMS_PROVIDER="log"
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
SMS_SENDER="Sankhuu"

# ── Диспетчер (ADMIN) эрх ──
# Таслалаар тусгаарласан нэвтрэх нэр эсвэл утас (+976…). Эдгээр хэрэглэгч нэвтрэхэд ADMIN болж /admin руу орно.
ADMIN_USERS=""

# ── AI бараа бүртгэл (Claude) ──
# console.anthropic.com → API Keys. Байхгүй бол AI хэсэг унтарч, бараа гараар бүртгэгдэнэ.
ANTHROPIC_API_KEY=""

# (Заавал биш) Supabase-ийн CA сертификат (PEM). Өгвөл DB холболтын сертификатыг бүрэн шалгана.
# Supabase → Project Settings → Database → SSL Configuration → Download certificate
SUPABASE_CA_CERT=""
